# 复制为 .env 并填入真实值
# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 腾讯云 COS
VITE_COS_BUCKET=your-bucket-1250000000
VITE_COS_REGION=ap-guangzhou
VITE_COS_DOMAIN=https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
# 仅开发/自测直传使用；生产请改为 Edge Function 代传，不要在前端暴露永久密钥
VITE_COS_SECRET_ID=
VITE_COS_SECRET_KEY=
